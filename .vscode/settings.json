// CS 3113 workspace settings.
// Every run button in this folder builds through the Makefile, because raylib needs
// -IC:/raylib/include and -lraylib/-lopengl32/-lgdi32/-lwinmm that plain g++ won't add.
{
  "github.copilot.enable": {
    "*": false,
    "cpp": false,
    "c": false,
    "makefile": false
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.chat.followUps": "never",
  "editor.inlineSuggest.enabled": false,
  "code-runner.executorMap": {
    "cpp": "cd $dir && make run",
    "c": "cd $dir && make run"
  },
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "C_Cpp.debugShortcut": false
}
